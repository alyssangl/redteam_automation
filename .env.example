# Copy to `.env` and fill in. docker-compose reads this file automatically.
# All values below (except OPENAI_API_KEY) have safe in-code defaults; override
# them for your lab. See REPRODUCIBILITY.md.

# --- Required ---
OPENAI_API_KEY=sk-replace-me

# --- Lab endpoints ---
# In docker-compose the Kali container is reachable by its service DNS name.
KALI_IP=kali
# The Metasploitable 3 target VM (Vagrant) on your lab network.
TARGET_IP=192.168.34.7
KALI_USER=kali
KALI_PASS=kali
MSF_PORT=55553
MSF_USER=kali
MSF_PASS=kali

# --- Optional model overrides (defaults are gpt-4o-mini / gpt-4o per stage) ---
# LGG_MODEL=gpt-4o-mini
# LGG_MODEL_INITIAL_ACCESS=gpt-4o-mini
